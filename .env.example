DB_HOST=db
DB_PORT=5432
DB_NAME=db
DB_USER=db_user
DB_PASSWORD=db_password

DATABASE_URL=postgresql+asyncpg://db_user:db_password@db:5432/db
JWT_SECRET=please-set-a-long-random-secret-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=120

API_PREFIX=/api/v1
LEGACY_SCHEMA=dev
BOOTSTRAP_FROM_LEGACY=true
ALLOW_SQLITE_FALLBACK=false

# Airflow / dbt paths used in DAG
DBT_PROJECT_HOST_PATH=/opt/airflow/dbt/my_matrix
DBT_PROFILES_HOST_PATH=/opt/airflow/dbt/profiles.yml
AIRFLOW_DOCKER_NETWORK=skill-matrix-project_my-network
